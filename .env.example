# From @BotFather
BOT_TOKEN=123456789:ABC-your-token-here
# Your group's ID (starts with -100). See README for how to find it.
GROUP_ID=-1001234567890

# Daily reminder
TIMEZONE=Asia/Tashkent
REMINDER_TIME=08:00
REMINDER_DAYS=mon,tue,wed,thu,fri

# Buttons offered for "where to claim" (separate with |)
CLAIM_LOCATIONS=School office|Reception|Security desk

# Items leave the loop after this many days (0 = never)
ITEM_EXPIRY_DAYS=30
MAX_ACTIVE_PER_USER=10

# Anti-spam
FLOOD_LIMIT=6
FLOOD_WINDOW=10
BLOCK_LINKS=true

DB_PATH=lostfound.db
